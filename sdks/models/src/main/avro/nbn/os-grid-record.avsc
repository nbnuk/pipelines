/**
 * Additional structure for GridReference model
 */
{
  "name": "OSGridRecord",
  "namespace": "org.gbif.pipelines.io.avro",
  "type": "record",
  "doc": "OS Grid details",
  "fields": [
    {"name": "id","type":"string" },
    {"name": "coreId","type":["null","string"],"default": null },
    {"name": "gridReference", "type":["null","string"], "default":null, "doc":"http://data.nbn.org/nbn/terms/gridReference"},
    {"name": "gridSizeInMeters", "type": ["null","int"], "default":null, "doc":"http://data.nbn.org/nbn/terms/gridSizeInMeters"},
    {"name": "easting", "type":["null","int"], "default":null, "doc":"http://data.nbn.org/nbn/terms/easting"},
    {"name": "northing", "type":["null","int"], "default":null, "doc":"http://data.nbn.org/nbn/terms/northing"},
    {"name": "created", "type": ["null", "long"], "default": null },
    {"name": "issues", "type": "IssueRecord", "default":{}, "doc":"http://data.nbn.org/nbn/terms/issues"}
  ]
}